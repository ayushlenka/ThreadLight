# Local dev database (docker compose). Copy this file to .env.
DATABASE_URL=postgresql+asyncpg://threadlight:threadlight@localhost:5433/threadlight

# Filled in during later milestones.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
