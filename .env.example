# Copy to .env and fill in. Setup guide: docs/self-hosting.md
# Check your configuration any time with: threadlight check

# --- Required -------------------------------------------------------------
# Discord bot token (Developer Portal > your app > Bot > Reset Token).
DISCORD_BOT_TOKEN=
# Your server's ID (Discord Developer Mode on, then right-click the server > Copy Server ID).
DISCORD_GUILD_ID=
# Embeddings for search (https://dash.voyageai.com). Free tier is enough for small servers.
VOYAGE_API_KEY=

# --- Recommended ----------------------------------------------------------
# Enables /ask answers and decision extraction (https://console.anthropic.com).
# Without it, ingestion and search still work.
ANTHROPIC_API_KEY=

# --- Database -------------------------------------------------------------
# Password for the bundled Postgres. Set it before the first `docker compose up`;
# it only applies when the database volume is first created.
POSTGRES_PASSWORD=threadlight
# Used when running the app from a local venv (development). The Docker stack ignores
# this and connects to its own `db` service.
DATABASE_URL=postgresql+asyncpg://threadlight:threadlight@localhost:5433/threadlight

# --- Optional -------------------------------------------------------------
# Models and effort for /ask answers and for decision extraction.
# ANSWER_MODEL=claude-opus-5-5
# ANSWER_EFFORT=medium
# EXTRACT_MODEL=claude-opus-5-5
# EXTRACT_EFFORT=low
# Host ports for the bundled database and the opt-in API.
# DB_PORT=5433
# API_PORT=8000
